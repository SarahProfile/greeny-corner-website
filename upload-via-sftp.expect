#!/usr/bin/expect -f

set timeout 60
log_user 1

spawn sftp -o StrictHostKeyChecking=no u436103792@92.113.19.61

expect {
    "*password:" {
        send "Letmelogin123#\r"
    }
    timeout {
        puts "Connection timeout"
        exit 1
    }
}

expect {
    "sftp>" {
        send "pwd\r"
    }
    timeout {
        puts "SFTP prompt timeout"
        exit 1
    }
}

expect {
    "sftp>" {
        send "ls -la\r"
    }
}

expect {
    "sftp>" {
        send "quit\r"
    }
}

expect eof
