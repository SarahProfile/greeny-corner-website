    "userNotFound": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a.",
    "invalidEmail": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u064a\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0635\u0627\u0644\u062d.",
    "validEmailRequired": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u064a\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0635\u0627\u0644\u062d \u0644\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631."
  },
  "support": {
    "title": "\u0645\u0631\u0643\u0632 \u0627\u0644\u062f\u0639\u0645",
    "subtitle": "\u0646\u062d\u0646 \u0647\u0646\u0627 \u0644\u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0641\u064a \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0627\u0644\u0642\u0635\u0648\u0649 \u0645\u0646 \u062c\u0631\u064a\u0646\u064a \u0643\u0648\u0631\u0646\u0631",
    "contactUs": "\u0627\u062a\u0635\u0644 \u0628\u0646\u0627",
    "emailSupport": "\u0627\u0644\u062f\u0639\u0645 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a",
    "emailSupportDesc": "\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a",
    "responseTime": "\u0648\u0642\u062a \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629",
    "responseTimeDesc": "\u0646\u0631\u062f \u0639\u0627\u062f\u0629\u064b \u062e\u0644\u0627\u0644",
    "responseTimeValue": "\u06f2\u06f4-\u06f4\u06f8 \u0633\u0627\u0639\u0629",
    "faq": "\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629",
    "faqQ1": "\u0643\u064a\u0641 \u064a\u0639\u0645\u0644 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a\u061f",
    "faqA1": "\u0645\u0627 \u0639\u0644\u064a\u0643 \u0633\u0648\u0649 \u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u0631\u0629 \u0644\u0623\u064a \u0646\u0628\u062a\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u064a\u0632\u0629 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0633\u064a\u062d\u0644\u0644 \u0646\u0638\u0627\u0645\u0646\u0627 \u0627\u0644\u0645\u062f\u0639\u0648\u0645 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u0635\u0648\u0631\u0629 \u0648\u064a\u062d\u062f\u062f \u0646\u0648\u0639 \u0627\u0644\u0646\u0628\u062a\u0629\u060c \u0645\u0632\u0648\u062f\u0627\u064b \u0625\u064a\u0627\u0643 \u0628\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0631\u0639\u0627\u064a\u0629 \u062a\u0641\u0635\u064a\u0644\u064a\u0629.",
    "faqQ2": "\u0643\u064a\u0641 \u062a\u0639\u0645\u0644 \u062a\u0630\u0643\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u064a\u061f",
    "faqA2": "\u0628\u0645\u062c\u0631\u062f \u0625\u0636\u0627\u0641\u0629 \u0646\u0628\u062a\u0629 \u0625\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u062a\u0643\u060c \u064a\u0636\u0639 \u062c\u0631\u064a\u0646\u064a \u0643\u0648\u0631\u0646\u0631 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u062c\u062f\u0648\u0644 \u0631\u064a \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0646\u0628\u062a\u0629. \u0633\u062a\u062a\u0644\u0642\u0649 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0641\u0648\u0631\u064a\u0629 \u0639\u0646\u062f\u0645\u0627 \u064a\u062d\u064a\u0646 \u0648\u0642\u062a \u0633\u0642\u064a \u0646\u0628\u0627\u062a\u0627\u062a\u0643.",
    "faqQ3": "\u0647\u0644 \u0628\u064a\u0627\u0646\u0627\u062a\u064a \u0622\u0645\u0646\u0629\u061f",
    "faqA3": "\u0646\u0639\u0645! \u0646\u062d\u0646 \u0646\u0623\u062e\u0630 \u062e\u0635\u0648\u0635\u064a\u062a\u0643 \u0628\u062c\u062f\u064a\u0629. \u062c\u0645\u064a\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0645\u0634\u0641\u0631\u0629 \u0648\u0645\u062d\u0641\u0648\u0638\u0629 \u0628\u0623\u0645\u0627\u0646. \u0644\u0646 \u0646\u0634\u0627\u0631\u0643 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0645\u0639 \u0623\u0637\u0631\u0627\u0641 \u062b\u0627\u0644\u062b\u0629 \u0623\u0628\u062f\u0627\u064b.",
    "faqQ4": "\u0647\u0644 \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u061f",
    "faqA4": "\u0646\u0639\u0645! \u064a\u062f\u0639\u0645 \u062c\u0631\u064a\u0646\u064a \u0643\u0648\u0631\u0646\u0631 \u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0648\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u0628\u062f\u064a\u0644 \u0628\u064a\u0646 \u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0623\u064a \u0648\u0642\u062a.",
    "faqQ5": "\u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u0646\u064a \u062d\u0630\u0641 \u062d\u0633\u0627\u0628\u064a\u061f",
    "faqA5": "\u064a\u0645\u0643\u0646\u0643 \u062d\u0630\u0641 \u062d\u0633\u0627\u0628\u0643 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0625\u0630\u0627 \u0643\u0646\u062a \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0639\u0644\u0649 support@greenycorner.ae \u0648\u0633\u0646\u0633\u0627\u0639\u062f\u0643 \u0641\u064a \u0627\u0644\u0639\u0645\u0644\u064a\u0629.",
